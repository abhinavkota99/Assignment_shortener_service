{
  "capabilities": [
    {
      "id": "link_creation",
      "title": "Create short links",
      "keywords": [
        "shorten",
        "short link",
        "short url",
        "short code",
        "link shortener"
      ],
      "requirements": [
        "A client can submit an absolute http(s) URL and receive a unique, non-guessable short code and short URL.",
        "Invalid, unsafe or self-referencing destination URLs are rejected with a validation error."
      ],
      "acceptance": [
        "POST /api/v1/links with a valid URL returns 201 with code, shortUrl, targetUrl and createdAt",
        "Non-http(s), credential-bearing, private-network and malformed URLs return 400 validation_failed"
      ],
      "evidence": [
        "type:ShortenerService",
        "text:/api/v1/links"
      ],
      "tasks": [
        "T-domain",
        "T-config",
        "T-store",
        "T-service",
        "T-api",
        "T-bootstrap"
      ],
      "api": [
        "POST /api/v1/links: create a link (JSON body {url, alias?})",
        "GET /api/v1/links/{code}: link metadata"
      ],
      "risks": [
        "open-redirect abuse (phishing) - mitigated by URL validation and rate limiting",
        "code enumeration - mitigated by CSPRNG base62 codes"
      ]
    },
    {
      "id": "custom_alias",
      "title": "Custom aliases",
      "keywords": [
        "custom alias",
        "alias",
        "vanity"
      ],
      "requirements": [
        "A client may choose a custom alias instead of a generated code; aliases are unique and cannot shadow service routes."
      ],
      "acceptance": [
        "Creating an alias that exists returns 409 conflict",
        "Reserved words (api, healthz, metrics ...) are rejected"
      ],
      "evidence": [
        "text:aliasProblem"
      ],
