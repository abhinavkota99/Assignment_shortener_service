        "HEAD requests and link previews are not counted"
      ],
      "evidence": [
        "type:LinkStats"
      ],
      "tasks": [
        "T-service",
        "T-api"
      ],
      "api": [
        "GET /api/v1/links/{code}/stats?days=1..365: click analytics"
      ],
      "data": [
        "click events (code, timestamp, referrer, user agent) - no IP addresses stored"
      ]
    },
    {
      "id": "durability",
      "title": "Durable storage",
      "keywords": [
        "survive restart",
        "restarts",
        "durable",
        "persist"
      ],
      "requirements": [
        "Acknowledged writes survive a process restart or crash."
      ],
      "acceptance": [
        "Links and clicks are present after restart",
        "A torn final journal record is tolerated; corruption elsewhere fails startup"
      ],
      "evidence": [
        "type:JournalLinkRepository"
      ],
      "tasks": [
        "T-journal"
      ],
      "data": [
        "append-only JSON-lines journal with per-record format version"
      ],
      "risks": [
        "single-node storage: no replication (documented limitation)"
      ]
    },
    {
      "id": "idempotency",
      "title": "Safe retries (idempotent create)",
      "keywords": [
        "safe retries",
        "idempotent",
        "idempotency",
        "retries"
      ],
      "requirements": [
        "Clients can safely retry link creation using an Idempotency-Key without creating duplicates."
      ],
      "acceptance": [
        "Same Idempotency-Key returns the original link with 200",
        "Concurrent duplicates create exactly one link"
      ],
      "evidence": [
        "text:Idempotency-Key"
      ],
      "tasks": [
        "T-service"
      ]
    },
    {
      "id": "abuse_protection",
      "title": "Abuse protection",
      "keywords": [
        "abuse",
        "rate limit",
        "rate-limit",
        "throttl"
      ],
      "requirements": [
        "Link creation is rate limited per client and destination URLs are validated against abuse patterns."
      ],
      "acceptance": [
