        "visiting a short link",
        "visit a short link"
      ],
      "requirements": [
        "Requesting a short code redirects the caller to the destination URL."
      ],
      "acceptance": [
        "GET /{code} returns 302 with Location = target URL",
        "Unknown codes return 404"
      ],
      "evidence": [
        "text:HttpStatus.FOUND"
      ],
      "tasks": [
        "T-api"
      ],
      "api": [
        "GET|HEAD /{code}: 302 redirect (not cached by browsers so each click is counted)"
      ]
    },
