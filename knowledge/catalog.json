      ],
      "evidence": [
        "type:StorageHealthIndicator"
      ],
      "tasks": [
        "T-build",
        "T-api",
        "T-bootstrap"
      ]
    },
    {
      "id": "link_expiration",
      "title": "Link expiration",
      "keywords": [
        "expire",
        "expiry",
        "expiration",
        "ttl",
        "time-limited"
      ],
      "requirements": [
        "A client may set an optional expiry time (ISO-8601 UTC) when creating a link; it must be in the future and at most 5 years ahead.",
        "After expiry the short link stops redirecting and returns 410 Gone; expired visits are not counted as clicks.",
        "Metadata and analytics of expired links remain available; links created without expiry never expire."
      ],
      "acceptance": [
        "POST with expiresAt in the past or more than 5 years ahead returns 400",
        "GET /{code} after expiry returns 410 gone and records no click",
        "GET /api/v1/links/{code} shows expiresAt; stats remain available after expiry",
        "Journal records written before this change still load (no expiry)"
      ],
      "evidence": [
        "text:expiresAt"
      ],
      "tasks": [
        "T-expiry-domain",
        "T-expiry-store",
        "T-expiry-api",
        "T-expiry-tests"
      ],
      "api": [
        "POST /api/v1/links: new optional field expiresAt (additive, backward compatible)",
        "GET /api/v1/links/{code}: response gains expiresAt (null when not set)",
        "GET|HEAD /{code}: new status 410 gone for expired links"
      ],
      "data": [
        "journal 'link' record: optional expiresAt field; old records without it load as never-expiring (format version unchanged)"
      ],
      "risks": [
        "clock skew between instances could make expiry fire early or late by the skew - acceptable at second granularity",
        "clients that cached a 302 keep redirecting after expiry - mitigated: redirects are sent with Cache-Control private, max-age=0"
      ]
    },
    {
      "id": "destination_denylist",
      "title": "Block known-malicious destinations",
      "keywords": [
        "denylist",
        "blocklist",
        "malicious domain"
      ],
      "requirements": [
        "Operators can configure a denylist of destination domains (including their subdomains); links to them cannot be created."
      ],
      "acceptance": [
        "With SHORTENER_BLOCKED_HOSTS=evil.example, creating a link to https://a.evil.example/x returns 400",
        "Other domains are unaffected"
      ],
      "evidence": [
        "type:DenylistUrlValidator"
      ],
      "tasks": [
        "T-denylist",
        "T-denylist-wiring"
      ],
      "api": [
        "POST /api/v1/links: may now return 400 validation_failed for denylisted hosts (same error shape)"
      ],
      "risks": [
        "static denylist goes stale; a reputation feed would be a follow-up",
        "existing links to newly blocked domains keep working (scope decision)"
      ]
